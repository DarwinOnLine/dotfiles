+"""
+Claude Limits - shows Anthropic's own usage percentage for the active account.
+
+Unlike the ccusage-based actions, this reads `claude -p "/usage"`, so there is
+no token limit to configure: the percentage is the one Anthropic computes, for
+whichever account `claude` is currently logged into. It also survives an account
+switch, which the local session logs cannot - they carry no account identifier.
+"""
+
+import threading
+
+import gi
+from loguru import logger as log
+
+gi.require_version("Gtk", "4.0")
+gi.require_version("Adw", "1")
+from gi.repository import Adw, Gtk, GLib
+
+from src.backend.PluginManager.ActionBase import ActionBase
+
+from .. import _shared as shared
+
+WINDOWS = ["session", "week"]
+DEFAULT_WINDOW = "session"
+DEFAULT_REFRESH_SECONDS = 120
+
+
+class ClaudeLimits(ActionBase):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.has_configuration = True
+
+        self._stop_event = threading.Event()
+        self._worker_thread: threading.Thread | None = None
+
+    # ------------------------------------------------------------------ #
+    # Lifecycle
+    # ------------------------------------------------------------------ #
+
+    def on_ready(self):
+        shared.set_static_icon(self)
+        self.set_top_label(text=self._top_label(), font_size=12, **shared.LABEL_OUTLINE)
+        self.set_center_label(text=self.tr("claude-usage.label.loading"), font_size=20, **shared.LABEL_OUTLINE)
+        self.set_bottom_label(text="", font_size=11, **shared.LABEL_OUTLINE)
+        self._start_worker()
+
+    def on_remove(self):
+        self._stop_event.set()
+
+    def on_key_down(self):
+        threading.Thread(
+            target=self._refresh_once, daemon=True, name="ClaudeLimits-manual-refresh"
+        ).start()
+
+    def tr(self, key: str) -> str:
+        return self.plugin_base.lm.get(key)
+
+    def _top_label(self) -> str:
+        window = self._settings().get("window", DEFAULT_WINDOW)
+        return self.tr(f"claude-limits.label.top.{window}")
+
+    # ------------------------------------------------------------------ #
+    # Settings
+    # ------------------------------------------------------------------ #
+
+    def _settings(self) -> dict:
+        settings = self.get_settings()
+        settings.setdefault("command", shared.DEFAULT_CLAUDE_COMMAND)
+        settings.setdefault("window", DEFAULT_WINDOW)
+        settings.setdefault("refresh_seconds", DEFAULT_REFRESH_SECONDS)
+        self.set_settings(settings)
+        return settings
+
+    def get_config_rows(self) -> list:
+        settings = self._settings()
+
+        command_row = Adw.EntryRow(title=self.tr("claude-limits.command.title"))
+        command_row.set_text(str(settings.get("command", shared.DEFAULT_CLAUDE_COMMAND)))
+        command_row.connect("notify::text", self._on_command_changed)
+
+        window_row = Adw.ActionRow(
+            title=self.tr("claude-limits.window.title"),
+            subtitle=self.tr("claude-limits.window.subtitle"),
+        )
+        window_dropdown = Gtk.DropDown(
+            model=Gtk.StringList.new([self.tr(f"claude-limits.window.{w}") for w in WINDOWS]),
+            valign=Gtk.Align.CENTER,
+        )
+        current = str(settings.get("window", DEFAULT_WINDOW))
+        window_dropdown.set_selected(WINDOWS.index(current) if current in WINDOWS else 0)
+        window_dropdown.connect("notify::selected", self._on_window_changed)
+        window_row.add_suffix(window_dropdown)
+        window_row.set_activatable_widget(window_dropdown)
+
+        refresh_row = Adw.EntryRow(title=self.tr("claude-usage.refresh.title"))
+        refresh_row.set_text(str(settings.get("refresh_seconds", DEFAULT_REFRESH_SECONDS)))
+        refresh_row.connect("notify::text", self._on_refresh_changed)
+
+        return [command_row, window_row, refresh_row]
+
+    def _on_command_changed(self, entry, _):
+        settings = self.get_settings()
+        settings["command"] = entry.get_text().strip() or shared.DEFAULT_CLAUDE_COMMAND
+        self.set_settings(settings)
+
+    def _on_window_changed(self, dropdown, _):
+        settings = self.get_settings()
+        settings["window"] = WINDOWS[dropdown.get_selected()]
+        self.set_settings(settings)
+        self.set_top_label(text=self._top_label(), font_size=12, **shared.LABEL_OUTLINE)
+
+    def _on_refresh_changed(self, entry, _):
+        settings = self.get_settings()
+        settings["refresh_seconds"] = shared.parse_int(
+            entry.get_text(), DEFAULT_REFRESH_SECONDS, minimum=shared.MIN_REFRESH_SECONDS
+        )
+        self.set_settings(settings)
+
+    # ------------------------------------------------------------------ #
+    # Background refresh
+    # ------------------------------------------------------------------ #
+
+    def _start_worker(self):
+        if self._worker_thread and self._worker_thread.is_alive():
+            return
+        self._stop_event.clear()
+        self._worker_thread = threading.Thread(
+            target=self._worker_loop, daemon=True, name=f"ClaudeLimits-{self.action_id}"
+        )
+        self._worker_thread.start()
+
+    def _worker_loop(self):
+        while not self._stop_event.is_set():
+            self._refresh_once()
+            interval = max(
+                shared.MIN_REFRESH_SECONDS,
+                int(self._settings().get("refresh_seconds", DEFAULT_REFRESH_SECONDS)),
+            )
+            self._stop_event.wait(interval)
+
+    def _refresh_once(self):
+        settings = self._settings()
+        command = settings.get("command", shared.DEFAULT_CLAUDE_COMMAND)
+        window = settings.get("window", DEFAULT_WINDOW)
+        try:
+            percent, reset = shared.fetch_usage(command, window)
+            error = None
+        except Exception as e:  # noqa: BLE001 - surface any failure on the key
+            percent, reset, error = None, "", str(e)
+
+        GLib.idle_add(self._render, percent, reset, error, settings)
+
+    # ------------------------------------------------------------------ #
+    # Rendering
+    # ------------------------------------------------------------------ #
+
+    def _render(self, percent, reset, error, settings):
+        if error is not None:
+            shared.set_static_icon(self)
+            self.set_center_label(text="!", font_size=22, **shared.LABEL_OUTLINE)
+            self.set_bottom_label(text=self.tr("claude-limits.label.error"), font_size=10, **shared.LABEL_OUTLINE)
+            self.set_background_color(shared.COLOR_CRIT)
+            log.error(f"[ClaudeLimits] {error}")
+            return False
+
+        if percent >= 90:
+            color = shared.COLOR_CRIT
+        elif percent >= 70:
+            color = shared.COLOR_WARN
+        else:
+            color = shared.COLOR_OK
+
+        self.set_media(image=shared.render_ring_image(percent, color), size=0.97)
+        self.set_background_color(shared.COLOR_NONE)
+
+        self.set_top_label(text=self._top_label(), font_size=12, **shared.LABEL_OUTLINE)
+        self.set_center_label(text=f"{percent}%", font_size=20, **shared.LABEL_OUTLINE)
+        self.set_bottom_label(
+            text=self.tr("claude-limits.label.resets-at").format(time=reset) if reset else "",
+            font_size=11,
+            **shared.LABEL_OUTLINE,
+        )
+        return False
