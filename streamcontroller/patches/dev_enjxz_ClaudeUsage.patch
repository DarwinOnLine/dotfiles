 import json
 import os
+import re
 import subprocess
 
 from PIL import Image, ImageDraw
 
 DEFAULT_COMMAND = "npx --yes ccusage@latest"
+# `claude -p "/usage"` runs the in-session slash command headlessly. It reports
+# Anthropic's own server-side percentages for the active account, so there is no
+# token limit to calibrate - and it costs nothing (num_turns 0, no model call).
+DEFAULT_CLAUDE_COMMAND = "claude"
 DEFAULT_REFRESH_SECONDS = 60
 MIN_REFRESH_SECONDS = 15
 
@@ -106,7 +111,7 @@
     return result
 
 
-def run_ccusage(command: str, args: str, timeout: int = 25) -> dict:
+def run_host_json(command: str, args: str, timeout: int = 25) -> dict:
     """
     Runs `<command> <args>` on the host and returns the parsed JSON stdout.
 
@@ -153,3 +158,40 @@
     icon_path = os.path.join(action.plugin_base.PATH, "assets", "icon.png")
     if os.path.isfile(icon_path):
         action.set_media(media_path=icon_path, size=size, valign=valign)
+
+
+# Kept for the ccusage-based actions, which predate the /usage source.
+run_ccusage = run_host_json
+
+# "Current session: 24% used · resets Sep 4, 5:50pm (Europe/Paris)"
+USAGE_LINES = {
+    "session": re.compile(r"Current session:\s*(\d+)%\s*used(?:\s*.\s*resets\s*([^(\n]+))?"),
+    "week": re.compile(r"Current week \(all models\):\s*(\d+)%\s*used(?:\s*.\s*resets\s*([^(\n]+))?"),
+}
+
+
+def fetch_usage(command: str, window: str, timeout: int = 30) -> tuple[int, str]:
+    """
+    Runs `<command> -p --output-format json "/usage"` and returns
+    (percent, reset_label) for the requested window ("session" or "week").
+
+    Raises RuntimeError if the command fails or the line can't be found - the
+    wording of /usage is not a stable API, so a miss must surface on the key
+    rather than silently render 0%.
+    """
+    data = run_host_json(command, '-p --output-format json "/usage"', timeout=timeout)
+    text = data.get("result") or ""
+
+    match = USAGE_LINES[window].search(text)
+    if not match:
+        raise RuntimeError(f"no '{window}' line in /usage output")
+
+    percent = int(match.group(1))
+    reset = (match.group(2) or "").strip().rstrip(".")
+
+    # Session resets the same day, so the date half is noise on a 72px key;
+    # the weekly one needs it. "Sep 4, 5:50pm" -> "5:50pm" / kept whole.
+    if window == "session" and "," in reset:
+        reset = reset.split(",", 1)[1].strip()
+
+    return percent, reset
