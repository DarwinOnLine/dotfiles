 import pulsectl
 
+
+def input_sources(pulse):
+    """Real capture devices only, monitor sources excluded.
+
+    A monitor source mirrors an output. On cards where the microphones and the
+    speaker/HDMI sinks share one device.nick - the Ryzen HD Audio controller
+    does - a monitor cannot be told apart from a mic by nickname, so muting
+    "the mic" also muted desktop capture, and get_mute_state returned whichever
+    source the iteration happened to reach first.
+    """
+    return [s for s in pulse.source_list() if not s.name.endswith(".monitor")]
+
 class ToggleMute(ActionBase):
     def __init__(self, *args, **kwargs):
         super().__init__(*args, **kwargs)
